{
  "_comment": "Format for the gitignored .mcp.json. Copy to .mcp.json and adjust (server names here are generic roles: personal/work/club). No secrets go here. Secrets live in ~/.secrets.env, which no shell exports: each server that needs one starts through bin/hq-mcp-env, which reads the file and passes the server only the names listed before `--` (NAME=SOURCE renames). These servers are project-scoped, so they load only in an hq session. See docs/external-sources-setup.md.",

  "mcpServers": {
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "notion-write": {
      "type": "stdio",
      "command": "${HOME}/hq/bin/hq-mcp-env",
      "args": ["NOTION_TOKEN=HQ_NOTION_WRITE_TOKEN", "--", "npx", "-y", "@notionhq/notion-mcp-server"]
    },
    "gw-personal": {
      "type": "stdio",
      "command": "${HOME}/hq/bin/hq-mcp-env",
      "args": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "--", "uvx", "workspace-mcp", "--transport", "stdio", "--single-user", "--permissions", "gmail:readonly", "calendar:readonly"],
      "env": {
        "WORKSPACE_MCP_CREDENTIALS_DIR": "${HOME}/.google_workspace_mcp/personal",
        "WORKSPACE_MCP_PORT": "8110"
      }
    },
    "gw-work": {
      "type": "stdio",
      "command": "${HOME}/hq/bin/hq-mcp-env",
      "args": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "--", "uvx", "workspace-mcp", "--transport", "stdio", "--single-user", "--permissions", "gmail:readonly", "calendar:readonly"],
      "env": {
        "WORKSPACE_MCP_CREDENTIALS_DIR": "${HOME}/.google_workspace_mcp/work",
        "WORKSPACE_MCP_PORT": "8111"
      }
    },
    "gw-club": {
      "type": "stdio",
      "command": "${HOME}/hq/bin/hq-mcp-env",
      "args": ["GOOGLE_OAUTH_CLIENT_ID", "GOOGLE_OAUTH_CLIENT_SECRET", "--", "uvx", "workspace-mcp", "--transport", "stdio", "--single-user", "--permissions", "gmail:readonly", "calendar:readonly"],
      "env": {
        "WORKSPACE_MCP_CREDENTIALS_DIR": "${HOME}/.google_workspace_mcp/club",
        "WORKSPACE_MCP_PORT": "8112"
      }
    }
  }
}

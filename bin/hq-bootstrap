#!/usr/bin/env bash
# Seed the per-machine core files from their shipped examples, then create the
# bucket directories declared in layout.toml. Idempotent; never overwrites.
source "$(cd "$(dirname "$0")/.." && pwd)/lib/hq.sh"

# Copy a gitignored file from its .example twin, only when it is absent.
seed() {
    local target="$1" example="$2"
    [[ -f "$HQ_ROOT/$target" ]] && return 0
    [[ -f "$HQ_ROOT/$example" ]] || die "missing example: $example"
    cp "$HQ_ROOT/$example" "$HQ_ROOT/$target"
    ok "created  $target from $example (edit it, it is gitignored)"
}

# The three core files. layout.toml must exist before buckets() reads it below;
# CLAUDE.md is the charter an hq session loads; REGISTRY.md is the project map.
seed layout.toml layout.example.toml
seed CLAUDE.md    CLAUDE.example.md
seed REGISTRY.md  REGISTRY.example.md
# SOURCES.md, FLOWS.md, and RESOURCES.md are optional add-ons (external sources,
# cross-home flows, the resource ledger). Copy each from its .example twin by
# hand when you opt into that layer, so hq-audit does not check flows or sources
# you have not set up. See the README's "Optional" sections.

created=0
while read -r b; do
    [[ -n "$b" ]] || continue
    if [[ -d "$HOME/$b" ]]; then
        info "exists   ~/$b"
    else
        mkdir -p "$HOME/$b"
        ok "created  ~/$b"
        created=$((created + 1))
    fi
    # Active buckets get a matching archive/ subdir.
    arch="$(bucket_archive "$b")"
    if [[ -n "$arch" && ! -d "$HOME/$arch" ]]; then
        mkdir -p "$HOME/$arch"
        ok "created  ~/$arch"
        created=$((created + 1))
    fi
done < <(buckets)

info ""
info "$created director$([[ $created == 1 ]] && echo y || echo ies) created."

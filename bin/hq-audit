#!/usr/bin/env bash
# Report drift between the registry, layout.toml, and what is actually on disk.
# Exits non-zero when drift is found, so it works as a check in a loop.
#
# The "~/…" strings below are literal display text (the registry convention is
# $HOME-relative paths shown as ~/), not paths meant to expand. Hence:
# shellcheck disable=SC2088
source "$(cd "$(dirname "$0")/.." && pwd)/lib/hq.sh"

QUIET_DAYS="${HQ_QUIET_DAYS:-120}"
drift=0

# bash 3.2 (macOS) has no mapfile; read line-by-line into the arrays.
_buckets=(); while IFS= read -r l; do _buckets+=("$l"); done < <(buckets)
_exempt=();  while IFS= read -r l; do _exempt+=("$l"); done < <(exempt_paths)

is_exempt() {
    local d="$1" e
    for e in "${_exempt[@]}"; do [[ "$d" == "$e" ]] && return 0; done
    for e in "${_buckets[@]}"; do [[ "$d" == "$e" || "$d" == archive ]] && return 0; done
    return 1
}

# Roots whose immediate children should each be a registered project: every
# bucket that requires registration, plus that bucket's archive.
scan_roots() {
    local b a
    for b in "${_buckets[@]}"; do
        bucket_registers "$b" || continue
        printf '%s\n' "$b"
        a="$(bucket_archive "$b")"
        [[ -n "$a" ]] && printf '%s\n' "$a"
    done
}

is_registered_path() {
    local p="$1" r
    for r in "${_reg_paths[@]}"; do [[ "$p" == "$r" ]] && return 0; done
    return 1
}

info "== unregistered directories =="
found=0
for d in "$HOME"/*/; do
    name="$(basename "$d")"
    is_exempt "$name" && continue
    # A registered project sitting at top level is misplaced, not unknown --
    # different problem, different fix.
    if reg_has "$name" && [[ "$(reg_field "$name" path)" == "$name" ]]; then
        warn "~/$name is registered but still at top level — hq-move it into a bucket"
    else
        warn "~/$name is not registered and not exempt — hq-register it, or remove it"
    fi
    found=1; drift=1
done

# One level inside each bucket, which is where a clone lands: `git clone` into
# code/ and forgetting to register it used to be completely silent, because this
# section only ever looked at ~/*/. One level and no deeper on purpose --
# loop-engineering holds four nested repos and archive/code/cs3157 holds
# eighteen, none of which is a project in its own right.
_reg_paths=(); while IFS= read -r l; do _reg_paths+=("$l"); done < <(reg_paths)
while read -r root; do
    [[ -n "$root" ]] || continue
    for d in "$HOME/$root"/*/; do
        [[ -d "$d" ]] || continue
        rel="$root/$(basename "$d")"
        is_exempt "$rel" && continue
        is_registered_path "$rel" && continue
        warn "~/$rel is not registered — hq-register it, or remove it"
        found=1; drift=1
    done
done < <(scan_roots)
[[ $found == 0 ]] && ok "none"

info ""
info "== registry entries whose path is gone =="
found=0
while read -r n; do
    [[ -n "$n" ]] || continue
    p="$(reg_field "$n" path)"
    if [[ -z "$p" ]]; then
        warn "$n has no path field"; found=1; drift=1
    elif [[ ! -d "$HOME/$p" ]]; then
        warn "$n -> ~/$p does not exist"; found=1; drift=1
    fi
done < <(reg_names)
[[ $found == 0 ]] && ok "none"

info ""
info "== active projects quiet for more than $QUIET_DAYS days =="
found=0
while read -r n; do
    [[ -n "$n" ]] || continue
    [[ "$(reg_field "$n" status)" == "active" ]] || continue
    p="$(reg_field "$n" path)"; [[ -d "$HOME/$p" ]] || continue
    last="$(newest_mtime "$HOME/$p")"
    [[ -n "$last" ]] || continue
    days=$(( ( $(date +%s) - ${last%.*} ) / 86400 ))
    if (( days > QUIET_DAYS )); then
        warn "$n untouched for $days days — consider hq-archive"
        found=1; drift=1
    fi
done < <(reg_names)
[[ $found == 0 ]] && ok "none"

# Vault cross-check is optional: skipped entirely when no vault is present.
if [[ -d "$HOME/vault/projects" ]]; then
    info ""
    info "== vault cross-check =="
    found=0
    while read -r n; do
        [[ -n "$n" ]] || continue
        [[ "$(reg_field "$n" career)" == "no" ]] && continue
        v="$(reg_field "$n" vault)"
        if [[ -z "$v" ]]; then
            warn "$n has no vault entry and is not tagged 'career: no'"; found=1; drift=1
        elif [[ ! -f "$HOME/vault/$v" ]]; then
            warn "$n -> vault/$v is missing"; found=1; drift=1
        fi
    done < <(reg_names)
    for f in "$HOME"/vault/projects/*.md; do
        [[ -e "$f" ]] || continue
        rel="projects/$(basename "$f")"
        # A remote-only repo has no local checkout, so no registry entry matches
        # it; the vault file marks that with `mirrored: false`. (Not `external`,
        # which marks a collaborator-owned repo — a separate axis, and one that
        # stays checked out and registered.)
        grep -q "^mirrored: false" "$f" 2>/dev/null && continue
        if ! grep -q -- "- vault: $rel" "$HQ_REGISTRY" 2>/dev/null; then
            warn "vault/$rel matches no registry entry and is not marked 'mirrored: false' (no local checkout)"
            found=1; drift=1
        fi
    done
    [[ $found == 0 ]] && ok "none"
fi

# Flows cross-check is optional: skipped entirely when no FLOWS.md is present, the
# same way the vault block is guarded. A dead edge points at a home that moved or
# was archived without the flow being updated.
if [[ -f "$HQ_FLOWS" ]]; then
    info ""
    info "== flows with a dead source or target =="
    found=0
    while read -r fn; do
        [[ -n "$fn" ]] || continue
        tgt="$(flow_field "$fn" target)"
        src="$(flow_field "$fn" source)"
        if [[ -z "$tgt" ]] || ! flow_resolve_target "$tgt" >/dev/null; then
            warn "$fn: target '${tgt:-<none>}' resolves to no live project or vault"
            found=1; drift=1
        fi
        if [[ -z "$src" ]] || ! flow_resolve_source "$src" >/dev/null; then
            warn "$fn: source '${src:-<none>}' is not a live project, known SOURCES server, or existing path"
            found=1; drift=1
        fi
    done < <(flow_names)
    [[ $found == 0 ]] && ok "none"
fi

info ""
if [[ $drift == 0 ]]; then ok "no drift"; else warn "drift found"; fi
exit $drift
